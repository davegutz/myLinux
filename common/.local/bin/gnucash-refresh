#!/usr/bin/env bash
# gnucash-refresh - Bidirectional synchronization engine and supervisor for GnuCash & budget spreadsheets
# Managed by GNU Stow via myLinux
set -euo pipefail

# 1. Load configuration
CONF_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/gnucash/refresh-joint.conf"
CONF_LOCAL="${XDG_CONFIG_HOME:-$HOME/.config}/gnucash/refresh-joint.conf.local"

if [ -f "$CONF_FILE" ]; then
    # shellcheck source=/dev/null
    source "$CONF_FILE"
fi

if [ -f "$CONF_LOCAL" ]; then
    # shellcheck source=/dev/null
    source "$CONF_LOCAL"
fi

# Defaults if not defined
LOCAL_DIR="${LOCAL_DIR:-$HOME/Documents/Gutz_joint_gnucash}"
GNUCASH_FILE="${GNUCASH_FILE:-Gutz_joint.gnucash}"
if [ -z "${SPREADSHEET_FILES+x}" ] || [ ${#SPREADSHEET_FILES[@]} -eq 0 ]; then
    SPREADSHEET_FILES=(
        "budget avg less invest.ods"
        "categories_as_budget_20220101-20240301.ods"
    )
fi
GDRIVE_MOUNT="${GDRIVE_MOUNT:-$HOME/gdrive}"
REMOTE_BASE_PATH="${REMOTE_BASE_PATH:-Finance remote}"
REMOTE_FOLDER="${REMOTE_FOLDER:-Gutz_joint_gnucash}"
RCLONE_REMOTE="${RCLONE_REMOTE:-gdrive}"
CREATE_BACKUP="${CREATE_BACKUP:-true}"
BACKUP_DIR="${BACKUP_DIR:-$LOCAL_DIR/.backups}"
MAX_BACKUPS="${MAX_BACKUPS:-10}"
REMOTE_BACKUP="${REMOTE_BACKUP:-true}"
REMOTE_LOCK_ENABLED="${REMOTE_LOCK_ENABLED:-true}"
STALE_LOCK_HOURS="${STALE_LOCK_HOURS:-6}"
SYNC_ON_SAVE="${SYNC_ON_SAVE:-true}"
DEBOUNCE_SECONDS="${DEBOUNCE_SECONDS:-5}"
SYNC_ON_EXIT="${SYNC_ON_EXIT:-true}"
NOTIFY="${NOTIFY:-true}"

# CLI flags
REFRESH_ONLY=false
OPEN_ODS=false
OPEN_FOLDER=false
FORCE=false
DRY_RUN=false
SHOW_STATUS=false
FORCE_UNLOCK=false

usage() {
    cat << EOF
Usage: gnucash-refresh [OPTIONS]

Bidirectionally synchronizes local copies of $GNUCASH_FILE and related budget spreadsheets
with Google Drive ($REMOTE_BASE_PATH/$REMOTE_FOLDER) and supervises GnuCash.

Options:
  -r, --refresh-only    Refresh files from Google Drive without launching GnuCash
  -o, --open-ods        Open the budget spreadsheets in LibreOffice Calc
  -f, --open-folder     Open the local GnuCash directory in file manager
  -s, --status          Check and display sync status and cloud lock status
  -n, --dry-run         Simulate refresh actions without copying files
  --force               Force copy remote files or override cloud locks
  --unlock              Force release any existing cloud session lock on Google Drive
  -h, --help            Show this help message

Configuration file:
  $CONF_FILE
  $CONF_LOCAL (optional machine-specific override)
EOF
}

# Parse options
while [[ $# -gt 0 ]]; do
    case "$1" in
        -r|--refresh-only)
            REFRESH_ONLY=true
            shift
            ;;
        -o|--open-ods)
            OPEN_ODS=true
            shift
            ;;
        -f|--open-folder)
            OPEN_FOLDER=true
            shift
            ;;
        -s|--status)
            SHOW_STATUS=true
            shift
            ;;
        -n|--dry-run)
            DRY_RUN=true
            shift
            ;;
        --force)
            FORCE=true
            shift
            ;;
        --unlock)
            FORCE_UNLOCK=true
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            echo "Unknown option: $1"
            usage
            exit 1
            ;;
    esac
done

notify() {
    local urgency="$1"
    local title="$2"
    local message="$3"
    if [ "$NOTIFY" = true ] && command -v notify-send >/dev/null 2>&1; then
        notify-send -u "$urgency" -i gnucash-icon "$title" "$message" 2>/dev/null || true
    fi
}

ask_user_override() {
    local prompt_msg="$1"

    # Terminal stdin check
    if [ -t 0 ]; then
        echo -e "\n$prompt_msg"
        read -r -p "Do you want to override this lock and proceed? (y/N): " response
        [[ "$response" =~ ^[Yy]$ ]] && return 0
        return 1
    fi

    # KDE Plasma / Qt GUI dialog
    if command -v kdialog >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
        if kdialog --title "GnuCash Cloud Lock Warning" --yesno "$prompt_msg\n\nDo you want to override this lock and proceed?" 2>/dev/null; then
            return 0
        else
            return 1
        fi
    fi

    # GNOME / GTK dialog fallback
    if command -v zenity >/dev/null 2>&1 && [ -n "${DISPLAY:-${WAYLAND_DISPLAY:-}}" ]; then
        if zenity --question --title="GnuCash Cloud Lock Warning" --text="$prompt_msg\n\nDo you want to override this lock and proceed?" 2>/dev/null; then
            return 0
        else
            return 1
        fi
    fi

    # Default to aborting for safety
    return 1
}

# 2. Local single-instance lock setup
LOCK_FILE="/tmp/gnucash-refresh-$USER.lock"
exec 200>"$LOCK_FILE"
if ! flock -n 200; then
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] Another gnucash-refresh process is already active."
    notify "normal" "GnuCash Refresh" "Another sync operation is already in progress on this machine."
    exit 0
fi

# 3. Check if GnuCash currently has the book open locally
check_gnucash_active() {
    if pgrep -x gnucash >/dev/null 2>&1; then
        return 0
    fi

    # If GnuCash is not running but a leftover .LCK file exists, it is stale
    local lock_path="$LOCAL_DIR/${GNUCASH_FILE}.LCK"
    if [ -f "$lock_path" ]; then
        echo "[INFO] Removing stale local GnuCash lock file ($lock_path) from previous session."
        rm -f "$lock_path"
    fi
    return 1
}

if check_gnucash_active; then
    echo "[WARNING] GnuCash is currently running with $GNUCASH_FILE open."
    notify "critical" "GnuCash Active" "GnuCash currently has $GNUCASH_FILE open on this machine. Please save and close GnuCash before refreshing."
    if [ "$REFRESH_ONLY" = true ] || [ "$DRY_RUN" = true ]; then
        exit 1
    fi
    exit 0
fi

# 4. Ensure Google Drive is mounted or accessible
ensure_mount() {
    if mountpoint -q "$GDRIVE_MOUNT"; then
        return 0
    fi

    echo "Google Drive is not mounted at $GDRIVE_MOUNT. Attempting to mount..."
    if [ -x "$HOME/bin/Rclone" ]; then
        "$HOME/bin/Rclone" >/dev/null 2>&1 || true
        for _ in {1..10}; do
            if mountpoint -q "$GDRIVE_MOUNT"; then
                echo "Mounted successfully."
                return 0
            fi
            sleep 0.5
        done
    fi

    if ! mountpoint -q "$GDRIVE_MOUNT"; then
        echo "[ERROR] Google Drive mount ($GDRIVE_MOUNT) is unavailable."
        notify "critical" "Google Drive Error" "Google Drive is not mounted at $GDRIVE_MOUNT. Please launch Rclone first."
        return 1
    fi
    return 0
}

# 5. Verify Dedicated Remote Source Directory
find_remote_dir() {
    local target_remote_dir="$GDRIVE_MOUNT/$REMOTE_BASE_PATH/$REMOTE_FOLDER"

    if [ -d "$target_remote_dir" ]; then
        echo "$target_remote_dir"
        return 0
    fi

    echo "[ERROR] Dedicated remote folder does not exist: $target_remote_dir" >&2
    return 1
}

# 6. Safety Backup (Local)
backup_file() {
    local src_file="$1"
    local fname
    fname="$(basename "$src_file")"
    mkdir -p "$BACKUP_DIR"

    local ts
    ts=$(date '+%Y%m%d_%H%M%S')
    local bak_file="$BACKUP_DIR/${fname}.${ts}.bak"

    cp -p "$src_file" "$bak_file"
    echo "  [Backup] Created safety copy: $(basename "$bak_file")"

    # Prune old backups keeping MAX_BACKUPS
    if [ "${MAX_BACKUPS:-10}" -gt 0 ]; then
        local count
        count=$(find "$BACKUP_DIR" -maxdepth 1 -name "${fname}.*.bak" | wc -l)
        if [ "$count" -gt "$MAX_BACKUPS" ]; then
            find "$BACKUP_DIR" -maxdepth 1 -name "${fname}.*.bak" -printf "%T@ %p\n" | \
                sort -n | head -n "$((count - MAX_BACKUPS))" | cut -d' ' -f2- | xargs -r rm -f
        fi
    fi
}

# Cloud Backup Helper (Remote)
backup_remote_file() {
    local remote_file="$1"
    if [ "$REMOTE_BACKUP" = true ] && [ -f "$remote_file" ]; then
        local r_backups="$REMOTE_DIR/.backups"
        mkdir -p "$r_backups"
        local fname
        fname="$(basename "$remote_file")"
        cp -p "$remote_file" "$r_backups/${fname}.$(date +%Y%m%d_%H%M%S).bak" 2>/dev/null || true
    fi
}

# 7. Cloud Session Lock Token Management (.session_lock)
CLOUD_LOCK_FILE=""

check_cloud_lock() {
    if [ "$REMOTE_LOCK_ENABLED" != true ]; then
        return 0
    fi

    local lock_path="$REMOTE_DIR/.session_lock"
    if [ ! -f "$lock_path" ]; then
        return 0
    fi

    # Read token contents
    local lock_machine=""
    local lock_user=""
    local lock_pid=""
    local lock_epoch=0
    local lock_time=""

    while IFS='=' read -r key value || [ -n "$key" ]; do
        case "$key" in
            machine) lock_machine="$value" ;;
            user) lock_user="$value" ;;
            pid) lock_pid="$value" ;;
            epoch) lock_epoch="$value" ;;
            time) lock_time="$value" ;;
        esac
    done < "$lock_path"

    local my_hostname
    my_hostname=$(hostname)

    # 1. Lock belongs to this machine
    if [ "$lock_machine" = "$my_hostname" ] && [ "$lock_user" = "$USER" ]; then
        if [ -n "$lock_pid" ] && kill -0 "$lock_pid" 2>/dev/null && pgrep -x gnucash >/dev/null 2>&1; then
            echo "[WARNING] Active session lock held by this machine (PID $lock_pid)."
            notify "critical" "GnuCash Active" "GnuCash is already open and running on this machine."
            return 1
        else
            echo "[INFO] Reclaiming stale local cloud session lock from previous run ($lock_time)."
            rm -f "$lock_path"
            return 0
        fi
    fi

    # 2. Lock belongs to another machine / distribution
    local current_epoch
    current_epoch=$(date +%s)
    local age_hours=$(( (current_epoch - lock_epoch) / 3600 ))

    if [ "$FORCE" = true ] || [ "$FORCE_UNLOCK" = true ]; then
        echo "[NOTICE] Force override of cloud session lock held by $lock_machine."
        rm -f "$lock_path"
        return 0
    fi

    local warning_msg
    if [ "$age_hours" -ge "$STALE_LOCK_HOURS" ]; then
        warning_msg="Cloud lock held by '$lock_machine' (user '$lock_user') from $lock_time appears stale (older than ${STALE_LOCK_HOURS} hours)."
    else
        warning_msg="GnuCash Joint is currently active on '$lock_machine' (user '$lock_user', started $lock_time).\n\nProceeding concurrently may cause conflicting overwrites between your Linux distributions."
    fi

    echo -e "[WARNING] $warning_msg"
    if ask_user_override "$warning_msg"; then
        echo "[NOTICE] User chose to override cloud session lock from $lock_machine."
        rm -f "$lock_path"
        return 0
    else
        echo "[INFO] Launch aborted by user to preserve data integrity across distributions."
        notify "normal" "GnuCash Launch Cancelled" "Cloud lock held by '$lock_machine'. Launch cancelled."
        exit 0
    fi
}

acquire_cloud_lock() {
    if [ "$REMOTE_LOCK_ENABLED" != true ]; then
        return 0
    fi

    CLOUD_LOCK_FILE="$REMOTE_DIR/.session_lock"
    cat << EOF > "$CLOUD_LOCK_FILE"
machine=$(hostname)
user=$USER
pid=$$
epoch=$(date +%s)
time=$(date '+%Y-%m-%d %H:%M:%S %Z')
EOF
    echo "[Lock] Acquired cloud session lock on Google Drive."
}

release_cloud_lock() {
    if [ "$REMOTE_LOCK_ENABLED" != true ]; then
        return 0
    fi

    if [ -n "$CLOUD_LOCK_FILE" ] && [ -f "$CLOUD_LOCK_FILE" ]; then
        if grep -q "machine=$(hostname)" "$CLOUD_LOCK_FILE" 2>/dev/null; then
            rm -f "$CLOUD_LOCK_FILE"
            echo "[Lock] Released cloud session lock on Google Drive."
        fi
    fi
}

# Handle Open Folder
if [ "$OPEN_FOLDER" = true ]; then
    mkdir -p "$LOCAL_DIR"
    xdg-open "$LOCAL_DIR" >/dev/null 2>&1 &
    exit 0
fi

# Ensure mount before checking files
if ! ensure_mount; then
    exit 1
fi

REMOTE_DIR=$(find_remote_dir) || {
    echo "[ERROR] Dedicated remote folder not found: $GDRIVE_MOUNT/$REMOTE_BASE_PATH/$REMOTE_FOLDER"
    notify "critical" "GnuCash Refresh Failed" "Dedicated remote folder not found: $REMOTE_BASE_PATH/$REMOTE_FOLDER"
    exit 1
}

# Handle Force Unlock
if [ "$FORCE_UNLOCK" = true ]; then
    if [ -f "$REMOTE_DIR/.session_lock" ]; then
        rm -f "$REMOTE_DIR/.session_lock"
        echo "Successfully unlocked Google Drive repository ($REMOTE_DIR/.session_lock removed)."
        notify "normal" "GnuCash Cloud Lock" "Successfully removed cloud session lock from Google Drive."
    else
        echo "Google Drive repository is already unlocked."
    fi
    exit 0
fi

ALL_TARGET_FILES=("$GNUCASH_FILE" "${SPREADSHEET_FILES[@]}")

# Handle Status Display
if [ "$SHOW_STATUS" = true ]; then
    echo "=========================================================="
    echo " GnuCash Joint Auto-Refresh Launcher"
    echo " Remote Source : $REMOTE_DIR"
    echo " Local Target  : $LOCAL_DIR"
    echo "=========================================================="
    echo "--- Cloud Lock Status ---"
    if [ -f "$REMOTE_DIR/.session_lock" ]; then
        echo "  [LOCKED] Active session lock on Google Drive:"
        sed 's/^/    /' "$REMOTE_DIR/.session_lock"
    else
        echo "  [UNLOCKED] No active session lock on Google Drive."
    fi
    echo ""
    echo "--- File Sync Status ---"
    for item in "${ALL_TARGET_FILES[@]}"; do
        local_path="$LOCAL_DIR/$item"
        remote_path="$REMOTE_DIR/$item"

        if [ ! -f "$remote_path" ]; then
            echo "  [-] $item: Remote file NOT found"
            continue
        fi

        if [ ! -f "$local_path" ]; then
            echo "  [+] $item: Local file MISSING (remote available)"
            continue
        fi

        local_mtime=$(stat -c %Y "$local_path")
        remote_mtime=$(stat -c %Y "$remote_path")
        local_size=$(stat -c %s "$local_path")
        remote_size=$(stat -c %s "$remote_path")

        if [ "$local_size" -eq "$remote_size" ] && cmp -s "$local_path" "$remote_path"; then
            echo "  [=] $item: Identical (in sync)"
        elif [ "$remote_mtime" -gt "$local_mtime" ]; then
            echo "  [>] $item: Remote is NEWER (update available)"
        else
            echo "  [<] $item: Local is NEWER or DIFFERENT from remote"
        fi
    done
    exit 0
fi

# Check cloud lock before modifying any files or opening books
if ! check_cloud_lock; then
    exit 1
fi

echo "=========================================================="
echo " GnuCash Joint Auto-Refresh Launcher"
echo " Remote Source : $REMOTE_DIR"
echo " Local Target  : $LOCAL_DIR"
echo "=========================================================="

mkdir -p "$LOCAL_DIR"

UPDATED_COUNT=0
UPDATED_NAMES=()

# 8. Pull from Google Drive -> Local Target
for item in "${ALL_TARGET_FILES[@]}"; do
    local_path="$LOCAL_DIR/$item"
    remote_path="$REMOTE_DIR/$item"

    if [ ! -f "$remote_path" ]; then
        echo "[WARNING] Remote file not found: $item (skipping)"
        continue
    fi

    NEEDS_COPY=false

    if [ ! -f "$local_path" ]; then
        NEEDS_COPY=true
        echo "Local file missing: $item -> downloading from Google Drive"
    else
        if ! cmp -s "$local_path" "$remote_path"; then
            local_mtime=$(stat -c %Y "$local_path")
            remote_mtime=$(stat -c %Y "$remote_path")

            if [ "$remote_mtime" -gt "$local_mtime" ] || [ "$FORCE" = true ]; then
                NEEDS_COPY=true
                echo "Update available for $item (remote is newer)"
            elif [ "$local_mtime" -gt "$remote_mtime" ]; then
                echo "[NOTICE] Local copy of $item is newer than remote."
            else
                NEEDS_COPY=true
                echo "Differences detected in $item (sizes/contents differ)"
            fi
        fi
    fi

    if [ "$NEEDS_COPY" = true ]; then
        if [ "$DRY_RUN" = true ]; then
            echo "  [Dry Run] Would update: $item"
            UPDATED_COUNT=$((UPDATED_COUNT + 1))
            UPDATED_NAMES+=("$item")
            continue
        fi

        # Backup local version before replacing
        if [ -f "$local_path" ] && [ "$CREATE_BACKUP" = true ]; then
            backup_file "$local_path"
        fi

        # Copy remote file to local directory preserving timestamps
        cp -p "$remote_path" "$local_path"
        echo "  [Updated] Successfully refreshed: $item"
        UPDATED_COUNT=$((UPDATED_COUNT + 1))
        UPDATED_NAMES+=("$item")
    fi
done

# Pull Notifications
if [ "$UPDATED_COUNT" -gt 0 ]; then
    summary_list=$(IFS=', '; echo "${UPDATED_NAMES[*]}")
    echo "Refreshed $UPDATED_COUNT file(s): $summary_list"
    notify "normal" "GnuCash Joint Refreshed" "Refreshed $UPDATED_COUNT file(s) from Google Drive:\n$summary_list"
else
    echo "All local files are already up to date."
    notify "low" "GnuCash Joint" "Local files are up to date with Google Drive."
fi

# Open ODS spreadsheets if requested
if [ "$OPEN_ODS" = true ]; then
    if command -v libreoffice >/dev/null 2>&1; then
        echo "Opening budget spreadsheets in LibreOffice Calc..."
        for ods in "${SPREADSHEET_FILES[@]}"; do
            if [ -f "$LOCAL_DIR/$ods" ]; then
                libreoffice "$LOCAL_DIR/$ods" >/dev/null 2>&1 &
            fi
        done
    fi
fi

# If refresh-only or dry-run, exit cleanly now
if [ "$REFRESH_ONLY" = true ] || [ "$DRY_RUN" = true ]; then
    echo "Done."
    exit 0
fi

# 9. Supervised Execution & In-Session Watcher
TARGET_GNUCASH="$LOCAL_DIR/$GNUCASH_FILE"
if [ ! -f "$TARGET_GNUCASH" ]; then
    echo "[ERROR] Local GnuCash file not found: $TARGET_GNUCASH"
    notify "critical" "GnuCash Launch Error" "File not found: $TARGET_GNUCASH"
    exit 1
fi

# Acquire cloud session lock for the duration of this session
acquire_cloud_lock

cleanup_session() {
    echo "[Cleanup] Session ending. Performing final synchronization..."
    if [ "$SYNC_ON_EXIT" = true ]; then
        for f in "${ALL_TARGET_FILES[@]}"; do
            local l_file="$LOCAL_DIR/$f"
            local r_file="$REMOTE_DIR/$f"
            if [ -f "$l_file" ] && [ -d "$REMOTE_DIR" ]; then
                if ! cmp -s "$l_file" "$r_file"; then
                    local l_mtime
                    local r_mtime
                    l_mtime=$(stat -c %Y "$l_file")
                    r_mtime=$(stat -c %Y "$r_file" 2>/dev/null || echo 0)
                    if [ "$l_mtime" -gt "$r_mtime" ] || [ "$FORCE" = true ]; then
                        backup_remote_file "$r_file"
                        cp -p "$l_file" "$r_file"
                        echo "[Exit Sync] Saved final $f -> Google Drive"
                    fi
                fi
            fi
        done
    fi

    release_cloud_lock
    notify "low" "GnuCash Joint Closed" "All changes saved and synchronized to Google Drive."
}

# Trap signals for guaranteed clean termination without zombies
trap cleanup_session EXIT INT TERM HUP

echo "Launching GnuCash on $TARGET_GNUCASH..."
gnucash "$TARGET_GNUCASH" &
GNUCASH_PID=$!

# Record initial mtimes for file watcher
declare -A LAST_MTIMES
for f in "${ALL_TARGET_FILES[@]}"; do
    if [ -f "$LOCAL_DIR/$f" ]; then
        LAST_MTIMES["$f"]=$(stat -c %Y "$LOCAL_DIR/$f")
    else
        LAST_MTIMES["$f"]=0
    fi
done

# Watcher Loop: Runs strictly as long as GNUCASH_PID is alive
if [ "$SYNC_ON_SAVE" = true ]; then
    echo "[Supervisor] Watching for local saves (Ctrl+S) while GnuCash is running..."
    while kill -0 "$GNUCASH_PID" 2>/dev/null; do
        sleep 3

        MODIFIED_ITEMS=()
        for f in "${ALL_TARGET_FILES[@]}"; do
            local l_file="$LOCAL_DIR/$f"
            if [ -f "$l_file" ]; then
                current_mtime=$(stat -c %Y "$l_file")
                if [ "$current_mtime" -gt "${LAST_MTIMES["$f"]}" ]; then
                    MODIFIED_ITEMS+=("$f")
                fi
            fi
        done

        if [ ${#MODIFIED_ITEMS[@]} -gt 0 ]; then
            # Debounce pause to ensure write completion
            sleep "$DEBOUNCE_SECONDS"

            PUSHED_NAMES=()
            for f in "${MODIFIED_ITEMS[@]}"; do
                local l_file="$LOCAL_DIR/$f"
                local r_file="$REMOTE_DIR/$f"

                if [ -f "$l_file" ] && [ -d "$REMOTE_DIR" ]; then
                    if ! cmp -s "$l_file" "$r_file"; then
                        backup_remote_file "$r_file"
                        cp -p "$l_file" "$r_file"
                        LAST_MTIMES["$f"]=$(stat -c %Y "$l_file")
                        PUSHED_NAMES+=("$f")
                        echo "[Save Sync] Synced $f -> Google Drive"
                    fi
                fi
            done

            if [ ${#PUSHED_NAMES[@]} -gt 0 ]; then
                notify "low" "GnuCash Joint Saved" "Saved changes synced to Google Drive:\n$(IFS=', '; echo "${PUSHED_NAMES[*]}")"
            fi
        fi
    done
else
    # Wait for GnuCash to exit
    wait "$GNUCASH_PID" 2>/dev/null || true
fi

# Normal termination triggers trap cleanup_session
echo "GnuCash session ended."
exit 0
