#!/usr/bin/env bash
# dotfiles - Management utility for the myLinux configuration repository

REPO_DIR="$HOME/Documents/GitHub/myLinux"

usage() {
    echo "Usage: dotfiles [command]"
    echo ""
    echo "Commands:"
    echo "  sync                  Pull latest changes (with clash guard) and re-stow configurations"
    echo "  update                Pull changes, re-stow, and run full system updates"
    echo "  push [msg]            Sync with GitHub, lock SecretsVault, commit, and push"
    echo "  status [args]         Show git status of the myLinux repository (use -r to fetch first)"
    echo "  check                 Check GitHub to see if remote updates or clashes exist"
    echo "  diff                  Show unstaged changes in the myLinux repository"
    echo "  camera                Install and configure security camera NVR (motionEye)"
    echo "  camera-review         Browse recorded camera captures (feh / vlc)"
    echo "  autostart [DE]        Manage autostart packages (cosmic | gnome | plasma | detect | status)"
    echo "  daemon [action]       Manage rclone daily backup daemon (status | enable | disable | run | logs)"
    echo "  security [action]     Security scanner & audit (scan | enable | disable | timer | logs)"
    echo "  secrets [action]      Manage Cryptomator SecretsVault for rclone.conf (sync | setup | push | pull | lock | status)"
    echo "  finance [action]      Manage financial vaults and backups (status | backup | lock | logs)"
    echo "  cd                    Print path to myLinux repository (eval \"cd \$(dotfiles cd)\")"
    echo "  help                  Show this help message"
}

# Run pre-flight GitHub & clash check on operational commands
if [ -x "$REPO_DIR/scripts/git_guard.sh" ]; then
    "$REPO_DIR/scripts/git_guard.sh" preflight "${1:-}"
fi

case "$1" in
    sync)
        "$REPO_DIR/scripts/sync.sh"
        ;;
    update)
        "$REPO_DIR/scripts/sync.sh" --update
        ;;
    push)
        shift
        "$REPO_DIR/scripts/git_guard.sh" push "$@"
        ;;
    resolve|clash)
        "$REPO_DIR/scripts/git_guard.sh" resolve
        ;;
    camera|install-camera|secure-cam)
        "$REPO_DIR/scripts/install_secure_cam.sh"
        ;;
    camera-review)
        shift
        camera-review "$@"
        ;;
    camera-timelapse)
        shift
        camera-timelapse "$@"
        ;;
    status)
        if [[ "${2:-}" == "-r" || "${2:-}" == "--remote" ]]; then
            echo "Fetching latest status from origin..."
            git -C "$REPO_DIR" fetch origin --quiet 2>/dev/null || true
        fi
        git -C "$REPO_DIR" status
        ;;
    check)
        echo "Checking GitHub for remote updates..."
        if ! git -C "$REPO_DIR" fetch origin --quiet 2>/dev/null; then
            echo "Warning: Could not connect to remote repository (offline or auth issue)."
            exit 1
        fi
        behind=$(git -C "$REPO_DIR" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
        ahead=$(git -C "$REPO_DIR" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)
        dirty=$(git -C "$REPO_DIR" status --porcelain 2>/dev/null | wc -l)

        if [ "$behind" -gt 0 ] && { [ "$ahead" -gt 0 ] || [ "$dirty" -gt 0 ]; }; then
            echo -e "\033[1;31m==> CLASH WARNING: myLinux is BEHIND GitHub by $behind commit(s) AND has local changes ($ahead ahead, $dirty uncommitted).\033[0m"
            echo "Run 'myLinux sync' to launch the interactive clash resolver."
        elif [ "$behind" -gt 0 ]; then
            echo -e "\033[1;33m==> myLinux is BEHIND GitHub by $behind commit(s).\033[0m"
            echo "Run 'myLinux sync' (or 'mylinux-sync') to pull and re-stow configurations."
        elif [ "$ahead" -gt 0 ] || [ "$dirty" -gt 0 ]; then
            echo -e "\033[1;32m==> myLinux has local changes ($ahead commit(s) ahead, $dirty uncommitted file(s)).\033[0m"
            echo "Run 'myLinux push \"commit message\"' to publish local changes to GitHub."
        else
            echo -e "\033[0;32m==> myLinux is UP TO DATE and CLEAN with GitHub.\033[0m"
        fi
        ;;
    diff)
        git -C "$REPO_DIR" diff
        ;;
    autostart)
        case "${2:-status}" in
            cosmic)
                echo "Stowing autostart-cosmic..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-cosmic
                ;;
            gnome)
                echo "Stowing autostart-gnome..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-gnome
                ;;
            plasma)
                echo "Stowing autostart-plasma..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-plasma
                ;;
            detect)
                de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
                echo "Detected Desktop Environment: $de"
                de_lower="$(echo "$de" | tr '[:upper:]' '[:lower:]')"
                if [[ "$de_lower" == *"cosmic"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-cosmic
                elif [[ "$de_lower" == *"gnome"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-gnome
                elif [[ "$de_lower" == *"kde"* || "$de_lower" == *"plasma"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-plasma
                else
                    echo "Could not automatically determine DE from '$de'. Choose cosmic, gnome, or plasma."
                fi
                ;;
            status|"")
                echo "=== ~/.config/autostart entries ==="
                ls -la "$HOME/.config/autostart"
                ;;
            *)
                echo "Usage: dotfiles autostart [cosmic|gnome|plasma|detect|status]"
                exit 1
                ;;
        esac
        ;;
    daemon)
        case "${2:-status}" in
            status)
                echo "=== Rclone Daily Backup Timer Status ==="
                systemctl --user status rclone-daily-backup.timer --no-pager || true
                echo ""
                echo "=== Next Scheduled Runs ==="
                systemctl --user list-timers --all | grep -E "(UNIT|rclone)" || true
                ;;
            enable)
                echo "Enabling and starting rclone daily backup timer..."
                systemctl --user daemon-reload
                systemctl --user enable --now rclone-daily-backup.timer
                echo "Timer enabled. Run 'dotfiles daemon status' to verify."
                ;;
            disable)
                echo "Disabling rclone daily backup timer..."
                systemctl --user disable --now rclone-daily-backup.timer
                ;;
            run)
                echo "Triggering immediate rclone daily backup..."
                systemctl --user start rclone-daily-backup.service
                systemctl --user status rclone-daily-backup.service --no-pager
                ;;
            logs)
                echo "=== Recent Rclone Daily Backup Service Logs ==="
                journalctl --user -u rclone-daily-backup.service -n 50 --no-pager
                if [ -f "$HOME/.local/state/rclone/daily-backup.log" ]; then
                    echo ""
                    echo "=== Last Log File Entries (~/.local/state/rclone/daily-backup.log) ==="
                    tail -n 30 "$HOME/.local/state/rclone/daily-backup.log"
                fi
                ;;
            *)
                echo "Usage: dotfiles daemon [status|enable|disable|run|logs]"
                exit 1
                ;;
        esac
        ;;
    security)
        case "${2:-scan}" in
            scan)
                "$HOME/.local/bin/sys-security-scan" "${@:3}"
                ;;
            status|timer)
                "$HOME/.local/bin/sys-security-scan" --timer status
                ;;
            enable)
                "$HOME/.local/bin/sys-security-scan" --timer enable
                ;;
            disable)
                "$HOME/.local/bin/sys-security-scan" --timer disable
                ;;
            logs|log)
                if [ -f "$HOME/.local/state/security-scan/latest.log" ]; then
                    echo "=== Latest Security Scan Log (~/.local/state/security-scan/latest.log) ==="
                    tail -n 50 "$HOME/.local/state/security-scan/latest.log"
                else
                    echo "No security scan log found yet (~/.local/state/security-scan/latest.log)."
                fi
                ;;
            *)
                echo "Usage: dotfiles security [scan|timer|enable|disable|logs]"
                exit 1
                ;;
        esac
        ;;
    secrets|vault)
        "$REPO_DIR/scripts/sync_secrets_vault.sh" "${@:2}"
        ;;
    finance)
        case "${2:-status}" in
            status)
                echo "=== GnuCash & Cloud Vault Status ==="
                gnucash-refresh --status
                echo ""
                echo "=== Sleep Auto-Lock Daemon Status ==="
                systemctl --user status finance-sleep-lock.service --no-pager || true
                ;;
            backup)
                echo "Triggering VeraCrypt USB finance backup..."
                finance-usb-backup "${@:3}"
                ;;
            lock)
                echo "Manually locking financial and secrets vaults..."
                for vname in FinanceVault SecretsVault; do
                    vault_mount="$HOME/.local/share/Cryptomator/mnt/$vname"
                    if mountpoint -q "$vault_mount" 2>/dev/null || grep -q "$vault_mount" /proc/mounts 2>/dev/null; then
                        fusermount -u -z "$vault_mount" 2>/dev/null || fusermount3 -u -z "$vault_mount" 2>/dev/null || true
                        rmdir "$vault_mount" 2>/dev/null || true
                        echo "Unmounted $vault_mount"
                    fi
                done
                if pgrep -x cryptomator >/dev/null 2>&1 || pgrep -f "^/usr/bin/cryptomator|^/opt/cryptomator|org\.cryptomator\.Cryptomator" >/dev/null 2>&1; then
                    flatpak kill org.cryptomator.Cryptomator 2>/dev/null || pkill -TERM -x cryptomator 2>/dev/null || true
                    echo "Terminated Cryptomator application."
                fi
                sed -i '/FinanceVault/d' "$HOME/.config/gtk-3.0/bookmarks" 2>/dev/null || true
                veracrypt_mount=""
                for cand in "/run/media/veracrypt1" "/media/veracrypt1"; do
                    if mountpoint -q "$cand" 2>/dev/null; then
                        veracrypt_mount="$cand"
                        break
                    fi
                done
                if [ -z "$veracrypt_mount" ]; then
                    veracrypt_mount="$(awk '$1 ~ /\/dev\/mapper\/veracrypt/ {print $2; exit}' /proc/mounts 2>/dev/null)"
                fi
                if [ -n "$veracrypt_mount" ] && mountpoint -q "$veracrypt_mount" 2>/dev/null; then
                    sync -f "$veracrypt_mount" 2>/dev/null || sync
                    veracrypt -d "$veracrypt_mount" 2>/dev/null || true
                    echo "Dismounted VeraCrypt USB volume at $veracrypt_mount."
                fi
                echo "All financial vaults are locked."
                ;;
            unlock)
                echo "=== Releasing Finance Session & Stale GnuCash Locks ==="
                gnucash-refresh --unlock
                ;;
            logs)
                echo "=== Sleep Auto-Lock Logs (~/.local/state/security/sleep-lock.log) ==="
                if [ -f "$HOME/.local/state/security/sleep-lock.log" ]; then
                    tail -n 25 "$HOME/.local/state/security/sleep-lock.log"
                fi
                echo ""
                echo "=== USB Backup Logs (~/.local/state/rclone/usb-backup.log) ==="
                if [ -f "$HOME/.local/state/rclone/usb-backup.log" ]; then
                    tail -n 25 "$HOME/.local/state/rclone/usb-backup.log"
                fi
                ;;
            setup|install)
                echo "=== Setting up Financial Vault (Cryptomator) ==="
                if ! [ -x /usr/bin/cryptomator ] && ! flatpak info org.cryptomator.Cryptomator >/dev/null 2>&1; then
                    echo "Cryptomator is not installed. Installing..."
                    if [ -f /etc/arch-release ]; then
                        sudo pacman -S --needed --noconfirm cryptomator
                    elif [ -f /etc/debian_version ]; then
                        if command -v add-apt-repository >/dev/null 2>&1; then
                            sudo add-apt-repository -y ppa:sebastian-stenzel/cryptomator
                            sudo apt-get update
                            sudo apt-get install -y cryptomator
                        elif command -v flatpak >/dev/null 2>&1; then
                            flatpak install -y flathub org.cryptomator.Cryptomator
                        fi
                    fi
                else
                    echo "Cryptomator is already installed."
                fi
                mkdir -p "$HOME/.local/share/Cryptomator/mnt"
                echo "Launching Cryptomator GUI..."
                cryptomator &
                echo ""
                echo "Next steps in Cryptomator:"
                echo "  1. Click '+' -> 'Open Existing Vault'"
                echo "  2. Select: $HOME/gdrive/FinanceVault"
                echo "  3. Enter passphrase to unlock (mounts at ~/.local/share/Cryptomator/mnt/FinanceVault)"
                echo "  4. (Tip) In Vault Options enable 'Save Password' & 'Unlock automatically'"
                ;;
            *)
                echo "Usage: dotfiles finance [status|setup|backup|lock|unlock|logs]"
                exit 1
                ;;
        esac
        ;;
    cd)
        echo "$REPO_DIR"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
