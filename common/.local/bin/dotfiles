#!/usr/bin/env bash
# dotfiles - Management utility for the myLinux configuration repository

REPO_DIR="$HOME/Documents/GitHub/myLinux"

usage() {
    echo "Usage: dotfiles [command]"
    echo ""
    echo "Commands:"
    echo "  sync                  Pull latest changes and re-stow configurations"
    echo "  update                Pull changes, re-stow, and run full system updates"
    echo "  status [args]         Show git status of the myLinux repository (use -r to fetch first)"
    echo "  check                 Check GitHub to see if remote updates are available"
    echo "  diff                  Show unstaged changes in the myLinux repository"
    echo "  autostart [DE]        Manage autostart packages (cosmic | gnome | plasma | detect | status)"
    echo "  daemon [action]       Manage rclone daily backup daemon (status | enable | disable | run | logs)"
    echo "  cd                    Print path to myLinux repository (eval \"cd \$(dotfiles cd)\")"
    echo "  help                  Show this help message"
}

case "$1" in
    sync)
        "$REPO_DIR/scripts/sync.sh"
        ;;
    update)
        "$REPO_DIR/scripts/sync.sh" --update
        ;;
    status)
        if [[ "${2:-}" == "-r" || "${2:-}" == "--remote" ]]; then
            echo "Fetching latest status from origin..."
            git -C "$REPO_DIR" fetch origin --quiet 2>/dev/null || true
        fi
        git -C "$REPO_DIR" status
        ;;
    check)
        echo "Checking GitHub for remote updates..."
        if ! git -C "$REPO_DIR" fetch origin --quiet 2>/dev/null; then
            echo "Warning: Could not connect to remote repository (offline or auth issue)."
            exit 1
        fi
        behind=$(git -C "$REPO_DIR" rev-list --count HEAD..@{u} 2>/dev/null || echo 0)
        ahead=$(git -C "$REPO_DIR" rev-list --count @{u}..HEAD 2>/dev/null || echo 0)

        if [ "$behind" -gt 0 ]; then
            echo -e "\033[1;33m==> myLinux is BEHIND GitHub by $behind commit(s).\033[0m"
            echo "Run 'dotfiles sync' (or 'mylinux-sync') to pull and re-stow configurations."
        elif [ "$ahead" -gt 0 ]; then
            echo -e "\033[1;32m==> myLinux is AHEAD of GitHub by $ahead commit(s).\033[0m"
            echo "Run 'git -C \$(dotfiles cd) push' (or 'gp') to publish local commits."
        else
            echo -e "\033[0;32m==> myLinux is UP TO DATE with GitHub.\033[0m"
        fi
        ;;
    diff)
        git -C "$REPO_DIR" diff
        ;;
    autostart)
        case "${2:-status}" in
            cosmic)
                echo "Stowing autostart-cosmic..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-cosmic
                ;;
            gnome)
                echo "Stowing autostart-gnome..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-gnome
                ;;
            plasma)
                echo "Stowing autostart-plasma..."
                cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-plasma
                ;;
            detect)
                de="${XDG_CURRENT_DESKTOP:-${DESKTOP_SESSION:-}}"
                echo "Detected Desktop Environment: $de"
                de_lower="$(echo "$de" | tr '[:upper:]' '[:lower:]')"
                if [[ "$de_lower" == *"cosmic"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-cosmic
                elif [[ "$de_lower" == *"gnome"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-gnome
                elif [[ "$de_lower" == *"kde"* || "$de_lower" == *"plasma"* ]]; then
                    cd "$REPO_DIR" && stow -v -R -t "$HOME" autostart-plasma
                else
                    echo "Could not automatically determine DE from '$de'. Choose cosmic, gnome, or plasma."
                fi
                ;;
            status|"")
                echo "=== ~/.config/autostart entries ==="
                ls -la "$HOME/.config/autostart"
                ;;
            *)
                echo "Usage: dotfiles autostart [cosmic|gnome|plasma|detect|status]"
                exit 1
                ;;
        esac
        ;;
    daemon)
        case "${2:-status}" in
            status)
                echo "=== Rclone Daily Backup Timer Status ==="
                systemctl --user status rclone-daily-backup.timer --no-pager || true
                echo ""
                echo "=== Next Scheduled Runs ==="
                systemctl --user list-timers --all | grep -E "(UNIT|rclone)" || true
                ;;
            enable)
                echo "Enabling and starting rclone daily backup timer..."
                systemctl --user daemon-reload
                systemctl --user enable --now rclone-daily-backup.timer
                echo "Timer enabled. Run 'dotfiles daemon status' to verify."
                ;;
            disable)
                echo "Disabling rclone daily backup timer..."
                systemctl --user disable --now rclone-daily-backup.timer
                ;;
            run)
                echo "Triggering immediate rclone daily backup..."
                systemctl --user start rclone-daily-backup.service
                systemctl --user status rclone-daily-backup.service --no-pager
                ;;
            logs)
                echo "=== Recent Rclone Daily Backup Service Logs ==="
                journalctl --user -u rclone-daily-backup.service -n 50 --no-pager
                if [ -f "$HOME/.local/state/rclone/daily-backup.log" ]; then
                    echo ""
                    echo "=== Last Log File Entries (~/.local/state/rclone/daily-backup.log) ==="
                    tail -n 30 "$HOME/.local/state/rclone/daily-backup.log"
                fi
                ;;
            *)
                echo "Usage: dotfiles daemon [status|enable|disable|run|logs]"
                exit 1
                ;;
        esac
        ;;
    cd)
        echo "$REPO_DIR"
        ;;
    help|--help|-h|"")
        usage
        ;;
    *)
        echo "Unknown command: $1"
        usage
        exit 1
        ;;
esac
