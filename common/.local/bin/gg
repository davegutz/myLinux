#!/usr/bin/env bash
# gg - Launch Dave G's custom Git GUI from myComputer repo
# Usage: gg [args]

SCRIPT_PATH="$HOME/Documents/GitHub/myComputer/git_gui.py"

if [ -f "$SCRIPT_PATH" ]; then
    exec python3 "$SCRIPT_PATH" "$@"
else
    echo "Notice: $SCRIPT_PATH not found."
    echo "Falling back to standard git status..."
    exec git status "$@"
fi
