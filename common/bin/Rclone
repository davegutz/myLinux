#!/bin/bash
MOUNT_DIR="$HOME/gdrive"

# Determine safe VFS cache limits based on distro / $HOME partition size
# (Can be overridden via RCLONE_VFS_CACHE_MAX_SIZE and RCLONE_VFS_CACHE_MAX_AGE in ~/.bashrc.local)
if [ -z "${RCLONE_VFS_CACHE_MAX_SIZE:-}" ]; then
    HOME_TOTAL_GB=$(df -PB1G "$HOME" 2>/dev/null | awk 'NR==2 {gsub(/G/,"",$2); print $2}')
    if [ -z "$HOME_TOTAL_GB" ] && command -v python3 >/dev/null 2>&1; then
        HOME_TOTAL_GB=$(python3 -c 'import os, shutil; print(int(shutil.disk_usage(os.path.expanduser("~")).total // (1024**3)))' 2>/dev/null || echo "")
    fi

    if [ -n "$HOME_TOTAL_GB" ] && [ "$HOME_TOTAL_GB" -le 40 ] 2>/dev/null; then
        RCLONE_VFS_CACHE_MAX_SIZE="2G"
        RCLONE_VFS_CACHE_MAX_AGE="${RCLONE_VFS_CACHE_MAX_AGE:-6h}"
    elif [ -n "$HOME_TOTAL_GB" ] && [ "$HOME_TOTAL_GB" -le 120 ] 2>/dev/null; then
        RCLONE_VFS_CACHE_MAX_SIZE="10G"
        RCLONE_VFS_CACHE_MAX_AGE="${RCLONE_VFS_CACHE_MAX_AGE:-12h}"
    elif [ -f /etc/debian_version ]; then
        # Conservative default for Lubuntu/Ubuntu installs if disk size detection is unavailable
        RCLONE_VFS_CACHE_MAX_SIZE="2G"
        RCLONE_VFS_CACHE_MAX_AGE="${RCLONE_VFS_CACHE_MAX_AGE:-6h}"
    else
        RCLONE_VFS_CACHE_MAX_SIZE="50G"
        RCLONE_VFS_CACHE_MAX_AGE="${RCLONE_VFS_CACHE_MAX_AGE:-24h}"
    fi
else
    RCLONE_VFS_CACHE_MAX_AGE="${RCLONE_VFS_CACHE_MAX_AGE:-24h}"
fi

# Clean up any stale or disconnected FUSE mountpoint before checking
if ! mountpoint -q "$MOUNT_DIR" 2>/dev/null; then
    fusermount3 -u -z "$MOUNT_DIR" 2>/dev/null || true
fi

# 1. Check if already mounted
if mountpoint -q "$MOUNT_DIR"; then
    echo "Google Drive is already mounted at $MOUNT_DIR."
    if rclone rc core/version >/dev/null 2>&1; then
        echo "Refreshing VFS directory cache in background..."
        rclone rc vfs/refresh recursive=true --fast-list >/dev/null 2>&1 &
    else
        echo "Note: The active rclone process was started without remote control (--rc)."
        echo "To restart with full cache control: fusermount3 -u $MOUNT_DIR && Rclone"
    fi
    exit 0
fi

# 2. Ensure target mount directory exists
mkdir -p "$MOUNT_DIR"

# 3. Mount Google Drive in background (prefer systemd-run if available, else standard background)
echo "Mounting Google Drive to $MOUNT_DIR (VFS cache max: $RCLONE_VFS_CACHE_MAX_SIZE, max age: $RCLONE_VFS_CACHE_MAX_AGE)..."
if command -v systemd-run >/dev/null 2>&1 && systemctl --user status >/dev/null 2>&1; then
    systemctl --user stop rclone-mount.service 2>/dev/null || true
    systemctl --user reset-failed rclone-mount.service 2>/dev/null || true
    systemd-run --user --unit=rclone-mount rclone mount gdrive: "$MOUNT_DIR" \
        --vfs-cache-mode full \
        --vfs-cache-max-size "$RCLONE_VFS_CACHE_MAX_SIZE" \
        --vfs-cache-max-age "$RCLONE_VFS_CACHE_MAX_AGE" \
        --dir-cache-time 1000h \
        --drive-chunk-size 128M \
        --buffer-size 64M \
        --poll-interval 15s \
        --multi-thread-streams 4 \
        --attr-timeout 1s \
        --no-checksum \
        --rc \
        --rc-no-auth >/dev/null 2>&1
else
    nohup rclone mount gdrive: "$MOUNT_DIR" \
        --vfs-cache-mode full \
        --vfs-cache-max-size "$RCLONE_VFS_CACHE_MAX_SIZE" \
        --vfs-cache-max-age "$RCLONE_VFS_CACHE_MAX_AGE" \
        --dir-cache-time 1000h \
        --drive-chunk-size 128M \
        --buffer-size 64M \
        --poll-interval 15s \
        --multi-thread-streams 4 \
        --attr-timeout 1s \
        --no-checksum \
        --rc \
        --rc-no-auth </dev/null >/dev/null 2>&1 &
    RCLONE_PID=$!
    disown "$RCLONE_PID"
fi

# 4. Wait up to 15 seconds for mountpoint to become ready
MOUNTED=false
for i in {1..30}; do
    if mountpoint -q "$MOUNT_DIR"; then
        MOUNTED=true
        break
    fi
    sleep 0.5
done

if [ "$MOUNTED" = false ]; then
    echo "Error: Failed to mount Google Drive to $MOUNT_DIR." >&2
    exit 1
fi

# 5. Background folder content listing (warms directory cache)
if rclone rc core/version >/dev/null 2>&1; then
    echo "Warming VFS directory cache in background..."
    rclone rc vfs/refresh recursive=true --fast-list >/dev/null 2>&1 &
fi

echo "Google Drive mounted successfully."
