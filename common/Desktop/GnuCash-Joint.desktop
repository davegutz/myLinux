[Desktop Entry]
Version=1.0
Type=Application
Name=GnuCash (Joint)
GenericName=Finance Management (Joint)
Comment=Refresh local copies from Google Drive and open Joint GnuCash
Exec=/home/daveg/.local/bin/gnucash-refresh
Icon=gnucash-icon
Terminal=true
Categories=Office;Finance;
StartupNotify=true
Actions=RefreshOnly;OpenFolder;OpenSpreadsheets;UnlockCloud;LaunchBackground;

[Desktop Action LaunchBackground]
Name=Launch Silently (No Terminal)
Exec=/home/daveg/.local/bin/gnucash-refresh --no-terminal
Icon=gnucash-icon

[Desktop Action RefreshOnly]
Name=Refresh from Google Drive Only
Exec=/home/daveg/.local/bin/gnucash-refresh --refresh-only
Icon=view-refresh

[Desktop Action OpenFolder]
Name=Open GnuCash Folder
Exec=/home/daveg/.local/bin/gnucash-refresh --open-folder
Icon=folder-open

[Desktop Action OpenSpreadsheets]
Name=Open Budget Spreadsheets (.ods)
Exec=/home/daveg/.local/bin/gnucash-refresh --open-ods
Icon=x-office-spreadsheet

[Desktop Action UnlockCloud]
Name=Release Cloud Lock
Exec=/home/daveg/.local/bin/gnucash-refresh --unlock
Icon=system-lock-screen
