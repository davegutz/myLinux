[Unit]
Description=myLinux Periodic System & Security Audit
Documentation=https://github.com/davegutz/myLinux
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/sys-security-scan --skip-install
Nice=19
IOSchedulingClass=idle

[Install]
WantedBy=default.target
